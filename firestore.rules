rules_version = '2';

// 벽에 닿을 수 있는 것과 없는 것.
//
// 2026-05-19부터 이 파일은 `allow read, write: if true` 한 줄이었다. 그때는
// 연결 자체가 문제인지 규칙이 문제인지 가르려고 일부러 전부 열었고, 좁히는
// 일이 출시 전으로 밀려 있었다. 이제 좁힌다.
//
// ── 이 규칙이 막는 것 ────────────────────────────────────────────────
//   · 남의 글 고치기·지우기 (messages는 만들기만 된다)
//   · 60자·다섯 줄을 건너뛴 글
//   · 숫자 칸에 글자를 넣은 글 — 그런 문서가 **하나만 있어도** /wall의
//     말풍선 좌표가 통째로 무효가 되어 열 개가 구석에 겹쳐 쌓였다(재현함)
//   · 영원히 안 사라지는 글 (createdAt을 먼 미래로 적어 3일 필터를 피하기)
//   · 문서에 모르는 칸을 새로 다는 것
//   · 쓸 수 없는 표현(욕설 · 혐오 · 차별어, 2026-10-19) — 목록은 src/lib/banned.ts
//
// ── 이 규칙이 못 막는 것 ─────────────────────────────────────────────
//   · 보내는 **횟수**. 한 사람이 초당 몇 번을 쓰든 규칙은 세지 못한다.
//     rate limit은 App Check나 Cloud Functions의 몫이다.
//   · 송출을 가로채는 것. 폰 앱이 공개 키 하나로 control/dock을 쓸 수
//     있어야 도킹이 도는 구조라, 같은 키를 든 사람도 같은 일을 할 수 있다.
//     규칙이 할 수 있는 것은 **값이 멀쩡한지**까지다.
//   · 목록에 없는 말. 숫자를 섞은 욕('씨8'), 욕 없는 비방, 새로 생긴 말은
//     통과한다 — 사람이 벽에서 내려야 한다.
//
// 값의 범위는 화면이 실제로 내놓는 값에서 왔다 — 크기 28~60(PhaseTone AXES),
// 빠르기 0.7~1.3, 무게 300~700, 기울기 0·-24·-32(slantFor), 색 열 조합
// (palettes-v2). 양끝에 여유를 조금 뒀다. 눈금을 손볼 때마다 학생 화면에
// "벽에 닿지 못했어요"가 뜨면 안 된다.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 한 줄 ────────────────────────────────────────────────────────

    function isHex(c) {
      return c is string && c.matches('#[0-9a-fA-F]{6}');
    }

    function validTone(t) {
      return t is map
        && t.keys().hasAll(['font', 'tone', 'wght', 'slnt', 'size', 'paletteIdx', 'graphicIdx'])
        && t.keys().hasOnly([
             'font', 'tone', 'wght', 'slnt', 'size', 'paletteIdx', 'graphicIdx',
             'align', 'backgroundColor', 'textColor', 'manner',
             // 2026-09-25: 3/5 막대의 자리(0~1). 모양은 서체별 표가 이 자리에서
             // 계산한다(palettes.ts · formFor). 옛 칸(tone·slnt·wght)도 같이 온다
             'speed', 'weight'
           ])
        // 옛 글이 서체를 잃지 않게 키는 그대로 둔다(palettes.ts fontMap)
        && t.font in ['ttoryeot', 'chabun', 'doran', 'deulseok', 'botong']
        // 아래 넷은 int로도 float로도 온다 — 0.85는 double, 44는 integer다
        && t.tone is number && t.tone >= 0.5 && t.tone <= 1.5
        && t.wght is number && t.wght >= 100 && t.wght <= 900
        && t.slnt is number && t.slnt >= -40 && t.slnt <= 40
        && t.size is number && t.size >= 10 && t.size <= 100
        && t.paletteIdx is int && t.paletteIdx >= 0 && t.paletteIdx <= 9
        && t.graphicIdx is int && t.graphicIdx >= -1 && t.graphicIdx <= 20
        // 2026-09-28: 나무(당당한) · 구름(다정한)의 제 정렬이 더해졌다(cloud.ts · arrangementsFor).
        // 같은 날 콘솔에서 게시했다 — 폰이 덜어 내던 거름(firebase.ts · toneForWall)도 걷었다.
        // 이어서 차분한(돌)의 제 정렬(올려 걸기 · 중간 걸기 · 내려 걸기, R17)을 더해 2026-09-29에 콘솔에서 게시했다.
        // 같은 날 나무를 다시 지으며 사선 · 세로쓰기를 더해 콘솔에서 게시했다
        && (!('align' in t) || t.align in ['left', 'center', 'right', 'distribute', 'trapezoid', 'arch', 'fan', 'smile',
             'hang-up', 'hang-mid', 'hang-down', 'slant', 'vertical',
             // 2026-10-04: 유머있는(비)의 모양 — 둥글 · 네모 · 뾰족(palettes.ts RAIN_FACE)
             'round', 'square', 'pointy',
             // 2026-10-06: 유머있는(비눗방울)의 떠다니기 — 둥실 · 흔들(기본은 center, lib/rain.ts bubbleMove)
             'float', 'wobble',
             // 2026-10-20: 도트 집합체의 4/5 열두 칸(lib/aggregate.ts arrangementsFor) — 당당 계단 · 단상, 차분 탑 · 내리막,
             // 유머 징검다리 · 하이킥(다정 아치 · 미소와 넷의 기본 center는 위에 있다). 옛 값은 사흘 안의 글 때문에 남긴다
             'stairs', 'podium', 'stack', 'descend', 'stepping', 'highkick'])
        && (!('manner' in t) || (t.manner is number && t.manner >= 0 && t.manner <= 1))
        && (!('speed' in t) || (t.speed is number && t.speed >= 0 && t.speed <= 1))
        && (!('weight' in t) || (t.weight is number && t.weight >= 0 && t.weight <= 1))
        && (!('backgroundColor' in t) || isHex(t.backgroundColor))
        && (!('textColor' in t) || isHex(t.textColor));
    }

    // ── 쓸 수 없는 표현 — scripts/banned-rules.mjs가 src/lib/banned.ts에서 옮겨 쓴다. 손으로 고치지 않는다 ──
    // 붙여 보기(한글 · 영문 밖을 다 지움)와 띄어 보기(기호를 띄어쓰기로)를 하고,
    // 둘 다 멀쩡한 말(예외)을 먼저 지운다. 까닭은 banned.ts 머리말.
    function noBanned(t) {
      let low = t.lower();
      let exc = '(하시바라이노스케|features|freenude|자지말아주세요|physics|thishit|데스티니시바|images|except|sexual|지킬앤하이드|지킬엔하이드|pushit|washit|fishit|dishit|hashit|cashit|오ㅗㅗㅗㅗ|호ㅗㅗㅗㅗ|로ㅗㅗㅗㅗ|옹ㅗㅗㅗㅗ|롤ㅗㅗㅗㅗ|요ㅗㅗㅗㅗ|우ㅗㅗㅗㅗ|하ㅗㅗㅗㅗ|시발자동차|시바스리갈|비슈누시바|시바핫카이|시바타이쥬|시바료타로|시바라스시|발로란트방|구로역시발|고양이새끼|호랑이새끼|새끼고양이|새끼호랑이|하시나보지|챙겨보지만|자지말자고|자지울거죠|자지마세요|https|phase|카플레이어|벙어리장갑|오ㅗㅗㅗ|호ㅗㅗㅗ|로ㅗㅗㅗ|옹ㅗㅗㅗ|롤ㅗㅗㅗ|요ㅗㅗㅗ|우ㅗㅗㅗ|하ㅗㅗㅗ|시불이익|다시바꿀|다시바꿔|다시불러|다시불안|시발택시|시발수뢰|아저씨바|아저씨발|시바이누|임시방편|가시방석|발로란트|무시발언|시바사키|벌었는데|쿨리발리|슈발리에|다시팔게|opgg|지근지근|지근속근|속든지근|지랄버릇|붕우유신|계속꺼져|사자새끼|새끼사자|새끼늑대|재밌게놈|무지개색|떠돌이개|날개같다|줫습니다|해줫더니|동그라미|뒤져봐야|뒤져보다|뒤져보는|뒤져보고|뒤져간다|보지도못|보지도않|인가보지|면접보지|영화보지|애니보지|만화보지|사진보지|그림보지|빨리보지|보지도마|보지는않|보지안으|보지안아|어케보지|하나보지|안보지만|물어보지|보지마라|언제자지|일찍자지|어케자지|자지도마|자지는않|자지좀마|자지마라|자지말고|cess|exit|exam|sexy|오야스미|스트레스|카시야스|유니섹스|스튜디오|자기위로|위대하지|무서운지|운지버섯|운지린다|더운지역|나따까리|카카오톡|같은년도|같은년에|같은년대|야스쿠니|홍어삼합|개년계획|개년동안|ㅗ먹어|ㅗㅗ오|ㅗㅗ호|ㅗㅗ로|ㅗㅗ옹|ㅗㅗ롤|ㅗㅗ요|ㅗㅗ우|ㅗㅗ하|다시방|시발음|정치발|시발점|시발유|시발역|시바견|시바산|시바신|오리발|다시바|다시팔|시바루|크시야|씨발라|일시불|아조씨|아저씨|저거시|우리발|피시방|피씨방|시발차|로벅스|쉬바나|엠씨방|시방향|알았지|몰랐지|지근거|지근하|미지근|지랄탄|전염병|감염병|화염병|왜꺼져|꺼져요|이꺼져|꺼져서|내꺼져|제꺼져|꺼져있|꺼져잇|꺼져도|꺼져가|의새끼|루세끼|시세끼|세끼먹|용새끼|말새끼|범새끼|삵새끼|키보드|새끼손|셰리프|로쉐리|새끼양|새끼용|새끼범|새끼삵|새끼개|생긴게|줫잖아|줫겠지|쫒기다|쫒기라|쫒기로|쫒기를|쫒기며|쫒기는|쫒기나|내쫒은|내쫒다|이미친|미친증|뒤질뻔|뒤져서|뒤져본|뒤져봄|뒤져볼|을보지|나보지|못보지|안보지|왜보지|뭐보지|다보지|게보지|켜보지|보지맙|초보지|로보지|가보지|홍보지|서보지|보지금|보지못|정지금|걸보지|보지는|보지지|보지않|해보지|보지마|보지말|지팡이|바보지|바보짓|봐보지|잠자지|남자지|여자지|감자지|왁자지|자지러|개발자|관리자|약탈자|타자지|자지원|사용자|경력자|자지마|자지말|지원자|부자지|혜자지|잘자지|일자지|자지금|자지않|안자지|못자지|ext|엑섹스|야스오|카구야|스파이|말이야|스티브|스쿼드|파랑색|노란색|빨간색|초록색|보라색|핑크색|검은색|하양색|주황색|연두색|스키장|야스톤|위대한|소유자|작업자|암살자|려운지|라운지|운지법|싸운지|깔보다|깔보시|흑형님|엄창못|하다가|먹다가|카와이|우리가|너희가|카카오|카세트|카운터|닥쳐오|닥쳐올|닥쳐온|닥쳐왔|애널리|자위대|자위권|자위적|졸라매|졸라맸|졸라메|애자일|존나중|존나라|홍어회|없애자|개년도|개년간|개년차|반드시|다시발|색끼리|발바닥|발걸음|발자국|발가락|오ㅗ|해ㅗ|호ㅗ|로ㅗ|옹ㅗ|롤ㅗ|요ㅗ|우ㅗ|하ㅗ|ㅗ오|ㅗ호|ㅗ로|ㅗ옹|ㅗ롤|ㅗ요|ㅗ우|ㅗ하|ㅇㅗ|ㅗㄷ|ㅗㅜ|rㅗ|ㅗr|sㅗ|ㅗs|eㅗ|ㅗe|fㅗ|ㅗf|aㅗ|ㅗa|qㅗ|ㅗq|ㅗw|wㅗ|ㅗd|dㅗ|ㅗg|gㅗ|ㅈㅗ|발닦|할시|벌어|발끝|젤리|발사|크시|어찌|발로|우리|혹시|바로|방장|빨리|파엠|벌금|불법|발릴|발표|방송|역시|바보|방탄|방어|상시|있지|없지|하지|근데|새로|있게|년생|에게|넘는|소개|줫음|쫒아|쫒는|쫒겨|쫒겻|쫒겼|쫒았|쫒다|쫒고|줫는|줫어|줬는|줫군|줬다|줬어|천조|쫒기|줫다|좇아|날개|거미|친구|개미|정보|행보|지급|혼자|지식|지원|지건|감자|청색|남색|스공|스시|스킨|스킬|스틸|스탑|해야|학자|상자|ㄴㄴ|미국|카톡|카페|카츠|카레|니가|내가|너가|카정|카드|카구|동시|임시|당시|즉시|잠시|도시|교시|실시|표시|지시|감시|전시|일시|게시|제시|항시|수시|개시|설시|보존|생존|공존|의존|잔존|실존|현존|온존|기존|예시|발화|발견|발생|발전|발급|발매|발음|발목|발등|발레|발달|발명|발효|발휘|발령|발간|발행|발톱|지금|지기|지나|지내|지갑|지구|지역|지하|지도|지난|지키|지켜|지우|지워|지친|지쳐|지각|지붕|지혜|바람|바다|바닥|바지|바깥|바퀴|바꾸|바꿔|바꿨|바뀌|바쁘|바빠|바빴|바랍|바위|바늘)';
      return t.matches('[^ᄀ-ᇿꥠ-꥿ힰ-퟿]*')
