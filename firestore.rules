        && !low.replace('[^가-힣ㄱ-ㅎㅏ-ㅣa-z]+', ' ').replace(exc, '').matches('.*(자살|강간|몰카|장애자|벙어리|귀머거리|절름발이|shit|sex|색수|새키|자위|게같은|개색|애자).*');
    }
    // ── 쓸 수 없는 표현 끝 ──

    function validMessage(d) {
      return d.keys().hasOnly(['text', 'tone', 'startedAt', 'createdAt'])
        && d.keys().hasAll(['text', 'tone', 'startedAt', 'createdAt'])
        && d.text is string
        && d.text.size() >= 1
        // 60자와 다섯 줄은 같은 규칙의 두 얼굴이다 — 벽의 한 줄이 열두 자다
        && d.text.size() <= 60
        && d.text.split('\n').size() <= 5
        // 2026-10-19: 욕설 · 혐오 · 차별어. 폰이 1/5와 보내기 직전에 막는 것과 같은 목록이다
        && noBanned(d.text)
        && d.startedAt is int && d.startedAt >= 0 && d.startedAt <= 4102444800000
        // 시각을 폰이 적는다. 먼 미래를 적으면 3일 필터를 영영 통과하므로
        // 서버가 받은 시각 근처인지 본다. 하루를 두는 건 폰 시계가 어긋나
        // 있어도 글이 막히지 않게 하기 위해서다 — 70년은 못 적는다.
        && d.createdAt is timestamp
        && d.createdAt <= request.time + duration.value(24, 'h')
        && d.createdAt >= request.time - duration.value(24, 'h')
        && validTone(d.tone);
    }

    // ── 제안 (완료 화면의 의견 칸, 2026-09-25) ─────────────────────────
    //
    // 받는 것은 본문과 보낸 시각 둘뿐이다. 시각은 서버가 정한다 — 폰이 보내는
    // 값이 요청 시각과 같아야만 통과한다(REST의 REQUEST_TIME 변환이 그렇게
    // 적는다). 새로 만들기만 되고, 고치기·지우기는 누구도 못 한다.
    //
    // 읽기는 관리자 계정 하나뿐이다. 계정은 Firebase 콘솔(Authentication)에서
    // 만들고 그 UID를 아래 목록에 넣는다. **비어 있는 동안은 아무도 못 읽는다**
    // — 기본이 닫힘이다.
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        // 2026-10-20 디자이너가 콘솔에서 만든 관리자 계정(이메일 · 비밀번호). 글 내리기와 제안 읽기
        'xuBnJhI81FYzuNjedC9XWC4Alz22'
      ];
    }

    function validFeedback(d) {
      return d.keys().hasOnly(['text', 'createdAt'])
        && d.keys().hasAll(['text', 'createdAt'])
        && d.text is string
        && d.text.trim().size() >= 1
        && d.text.size() <= 200
        && d.createdAt == request.time;
    }

    match /feedback/{id} {
      allow create: if validFeedback(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /messages/{id} {
      // 벽과 /admin이 로그인 없이 읽는다. 글 자체가 공개물이고 누가 썼는지는
      // 애초에 저장하지 않는다(익명성).
      allow read: if true;
      allow create: if validMessage(request.resource.data);
      // **보낸 뒤에는 수정할 수 없습니다** — 소개 화면이 학생에게 한 약속이
      // 이제 문서에도 적혀 있다.
      allow update: if false;
      // 예외 하나: 폰↔벽 왕복 테스트(scripts/e2e-dock.mjs)가 남긴 글. 테스트는
      // 실제 데이터베이스에 "왕복확인 …"을 쓰고 끝나면 지운다 — 못 지우면 그
      // 글이 사흘 동안 벽에 떠 있는다(2026-09-25에 실제로 그렇게 됐다).
      // 이 머리말로 시작하는 **한 줄** 글만 지울 수 있다('.'은 줄바꿈을 못 넘는다 —
      // 두 줄 시험 글이 못 지워져 콘솔에서 지웠다, 2026-10-20).
      //
      // 관리자는 어느 글이든 내린다(2026-10-20). 금지어 목록(src/lib/banned.ts)이
      // 놓친 비방 · 새 말을 사람이 거두는 길이다 — /admin의 '내리기'.
      allow delete: if isAdmin()
        || (resource.data.text is string && resource.data.text.matches('왕복확인 .*'));
    }

    // ── 도킹 신호 ────────────────────────────────────────────────────
    //
    // 문서 하나에 두 종류가 흐른다. 파이가 쓰는 칸(plugged·switchId·
    // switchAt·piAt)과 폰이 쓰는 칸(대기 자리·송출 사건)이다. 둘 다 같은
    // 공개 키를 쓰므로 **누가 썼는지로는 가를 수 없다.** 칸 이름과 값의
    // 꼴만 본다.

    // 폰과 벽이 이 값에서 30초를 센다. 엉뚱하게 크면 남은 시간이 거짓이 된다
    function okMs(v) {
      return v is int && v >= 0 && v <= 4102444800000;
    }

    function validDock(d) {
      return (!('plugged' in d) || d.plugged is bool)
        && (!('switchId' in d) || (d.switchId is string && d.switchId.size() <= 64))
        && (!('waitSession' in d) || (d.waitSession is string && d.waitSession.size() <= 64))
        && (!('waitMessage' in d) || (d.waitMessage is string && d.waitMessage.size() <= 64))
        && (!('startId' in d) || (d.startId is string && d.startId.size() <= 160))
        && (!('startSession' in d) || (d.startSession is string && d.startSession.size() <= 64))
        && (!('startMessage' in d) || (d.startMessage is string && d.startMessage.size() <= 64))
        && (!('switchAt' in d) || okMs(d.switchAt))
        && (!('piAt' in d) || okMs(d.piAt))
        && (!('waitAt' in d) || okMs(d.waitAt))
        && (!('startedAt' in d) || okMs(d.startedAt))
        && (!('endedAt' in d) || okMs(d.endedAt));
    }

    function dockKeys() {
      return [
        'plugged', 'switchId', 'switchAt', 'piAt',
        'waitSession', 'waitMessage', 'waitAt',
        'startId', 'startSession', 'startMessage', 'startedAt', 'endedAt'
      ];
    }

    match /control/dock {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(dockKeys())
                    && validDock(request.resource.data);
      // 고치는 칸만 본다(hasOnly가 아니라 affectedKeys). 지금 문서에 옛 칸이
      // 하나라도 남아 있으면 문서 전체를 재는 방식은 **모든 쓰기를 막는다** —
      // 그러면 설치물이 조용히 멎는다. 새 칸을 다는 것은 여전히 막힌다.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(dockKeys())
                    && validDock(request.resource.data);
      allow delete: if false;
    }

    // ── 나머지 ───────────────────────────────────────────────────────
    // 위에 적히지 않은 것은 전부 닫힌다. 옛 `control/display`도 여기 걸린다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
